# Telegram bot token from @BotFather
BOT_TOKEN=

# Optional numeric Telegram user ID for error notifications
ADMIN_ID=

# SQLite file path (Render persistent disk should be mounted at /var/data)
DATABASE_PATH=/var/data/bot.sqlite3

# Optional informational text shown after accepting an offer
TRANSFER_FEE_TEXT=Проверьте актуальную стоимость передачи в Telegram перед подтверждением.
