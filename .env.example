# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram user ID of the bot owner/admin
ADMIN_ID=7323296973

# SQLite is ephemeral on Render Free; data can be lost after restarts/redeploys
DATABASE_PATH=/tmp/bot.sqlite3

# Optional: set a stable secret for Telegram webhook validation.
# If omitted, a random secret is generated on each start.
WEBHOOK_SECRET=

# Optional public base URL. Render sets RENDER_EXTERNAL_URL automatically.
# WEBHOOK_BASE_URL=

# Informational text shown after accepting an offer
TRANSFER_FEE_TEXT=Telegram может запросить дополнительную комиссию в размере 25 Stars. Проверьте актуальную сумму перед подтверждением передачи.
